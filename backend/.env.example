# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database ---
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/DATABASE

# --- Auth ---
# Use a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d

# --- CORS ---
# Comma-separated list of allowed browser origins.
# Local Vite (legacy frontend) + local Next.js (new frontend) by default.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3100

# --- Checkout ---
# Tax percentage applied to the discounted item total. Demo default is 5.
TAX_RATE=5

# --- Legacy v1 only (kept for the old frontend) ---
CLIENT_DOMAIN=http://localhost:5173

# --- Cloudinary (used by legacy v1 uploads; v2 image handling comes later) ---
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# --- Orders ---
# Demo acceleration walks an order confirmed -> delivered inside the window
# below so it can be watched. The ETA shown to the customer stays realistic.
# Set to false for lifelike timing based on the restaurant's delivery estimate.
DEMO_ORDER_ACCELERATION=true
DEMO_ORDER_WINDOW_MINUTES=3

# --- Razorpay (TEST mode) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
